generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}
model test{
  id Int @id @default(autoincrement())
  name String
}
model User {
  id       Int     @id @default(autoincrement())
  name     String  @default("")
  password String  @default("")
  email    String?
  emailVerified Boolean @default(false)
  gameName String?
  role     String  @default("user")
  token String?  @default("")
  tokenExpiresAt DateTime?
  customUploadLimit Int     @default(5)
  authUploadLimit   Int     @default(1)
  isReviewer  Boolean @default(false)
  avatar     String? @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedModels ModelUploader[]
  bindings NameBinding[]
  reviewedModels Model[] @relation("ModelReviewer")
  comments ModelComment[]
}

model ModelComment {
  id        Int     @id @default(autoincrement())
  modelId   Int
  userId    Int
  content   String
  rating    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NameBinding {
  id                Int     @id @default(autoincrement())
  userId            Int
  gameName          String
  verificationCode  String
  token             String  @unique
  expiresAt         DateTime
  attempts          Int     @default(0)
  lastSentAt        DateTime
  createdAt         DateTime @default(now())

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Model {
  id           Int     @id @default(autoincrement())
  allowAuth    Boolean @default(false)
  currentType  String  @default("")
  hash         String  @default("")
  fileName     String  @default("")
  fileSize     Int     @default(0)
  imageUrl     String  @default("")
  description  String  @default("")
  reviewStatus String  @default("pending")
  reviewedBy   Int?
  reviewedAt   DateTime?
  downloadCount Int    @default(0)
  saveCount    Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploaders    ModelUploader[]
  authorizations ModelAuthorization[]
  reviewer     User?    @relation("ModelReviewer", fields: [reviewedBy], references: [id])
  comments     ModelComment[]
}

model ModelUploader {
  id        Int     @id @default(autoincrement())
  modelId   Int
  userId    Int
  createdAt DateTime @default(now())

  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([modelId, userId])
}

model ModelAuthorization {
  id        Int     @id @default(autoincrement())
  gameName  String  @default("")
  modelId   Int
  createdAt DateTime @default(now())

  model     Model   @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model SystemSettings {
  id        Int     @id @default(autoincrement())
  key       String  @unique
  value     String
  updatedAt DateTime @updatedAt
}
